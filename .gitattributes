# Line endings. Files that run or are read inside Linux containers must stay LF even on a
# Windows checkout with core.autocrlf=true, or bash fails on "\r" (veyra.sh, the Wazuh
# entrypoint) before anything starts.
*.sh text eol=lf
*.bash text eol=lf
Makefile text eol=lf
Caddyfile text eol=lf
*.Dockerfile text eol=lf
Dockerfile text eol=lf
*.toml text eol=lf
*.tmpl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.env text eol=lf
*.ps1 text eol=crlf
*.png binary
*.bin binary
