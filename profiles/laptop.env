# VEYRA profile: laptop (default) — 16 GB RAM, i5-13400H, RTX 3050 4 GB, Ubuntu LTS.
# Source of truth for these values: docs/plan/03_INFRA_PROFILES.md §2.
# Load order: code defaults -> this file -> .env.local -> shell env.
VEYRA_PROFILE=laptop
VEYRA_LOG_LEVEL=INFO
VEYRA_DATA_DIR=data

# --- §2.1 memory, CPU, Kafka -------------------------------------------------
VEYRA_MEM_KAFKA=1g
VEYRA_KAFKA_HEAP=512m
VEYRA_MEM_CLICKHOUSE=1g
VEYRA_CH_MAX_MEMORY=800m
VEYRA_MEM_WAZUH_INDEXER=1.8g
VEYRA_WAZUH_INDEXER_HEAP=1g
VEYRA_MEM_WAZUH_MANAGER=700m
VEYRA_MEM_WAZUH_DASHBOARD=800m
VEYRA_MEM_IMMUDB=256m
VEYRA_MEM_VECTOR=128m
VEYRA_MEM_PY_SERVICE=192m
VEYRA_NORMALIZER_REPLICAS=1
VEYRA_ROUTER_REPLICAS=1
VEYRA_RAW_PARTITIONS_PER_VENDOR=3
VEYRA_NORM_PARTITIONS=3
VEYRA_KAFKA_REPLICATION=1
# Keep these equal: a transactional producer needs transaction.timeout.ms >= delivery.timeout.ms.
VEYRA_KAFKA_DELIVERY_TIMEOUT_MS=120000
VEYRA_KAFKA_TXN_TIMEOUT_MS=120000

# --- endpoints ---------------------------------------------------------------
VEYRA_KAFKA_BOOTSTRAP=kafka:9092
# Used by host-side tools (make topics, make test-int, demo/tools/*).
VEYRA_KAFKA_BOOTSTRAP_HOST=localhost:29092
VEYRA_CLICKHOUSE_URL=http://clickhouse:8123
VEYRA_CLICKHOUSE_DB=veyra
VEYRA_IMMUDB_HOST=immudb
VEYRA_IMMUDB_PG_PORT=5432
# Host mapping for immudb's pg wire; 5432 is usually taken by a local PostgreSQL.
VEYRA_IMMUDB_PG_HOST_PORT=5433
VEYRA_IMMUDB_GRPC_PORT=3322

# --- topic retention (IF-TOPICS) --------------------------------------------
VEYRA_RETENTION_RAW_DAYS=3
VEYRA_RETENTION_REPLAY_DAYS=1
VEYRA_RETENTION_NORM_DAYS=3
VEYRA_RETENTION_LINEAGE_DAYS=3
VEYRA_RETENTION_DLQ_DAYS=14
VEYRA_RETENTION_SHADOW_DAYS=1
VEYRA_RETENTION_VAULT_INDEX_DAYS=3
VEYRA_RETENTION_RECEIPTS_DAYS=3
VEYRA_RETENTION_AUDIT_DAYS=30
VEYRA_DLQ_PARTITIONS=1
VEYRA_SHADOW_PARTITIONS=1
VEYRA_RECEIPTS_PARTITIONS=1
VEYRA_AUDIT_PARTITIONS=1

# --- §2.2 vault, integrity, lineage -----------------------------------------
VEYRA_SEGMENT_MAX_BYTES=2097152
VEYRA_SEGMENT_MAX_SECONDS=20
VEYRA_MERKLE_WINDOW_SECONDS=60
VEYRA_ZSTD_LEVEL=3
VEYRA_LINEAGE_TTL_DAYS=90
VEYRA_KEY_PROVIDER=local
# chattr +i needs CAP_LINUX_IMMUTABLE in the archiver container; set 0 if unavailable.
VEYRA_VAULT_CHATTR=1

# --- §2.3 engine and ingestion limits ---------------------------------------
VEYRA_MAX_EVENT_BYTES=65536
VEYRA_ENGINE_BUDGET_US=5000
VEYRA_PEEL_MAX_DEPTH=4
VEYRA_GATEWAY_DEFAULT_QUOTA_EPS=500
VEYRA_EDGE_MULTILINE_FLUSH_MS=500
VEYRA_EDGE_BUFFER_BYTES=268435456
VEYRA_GATEWAY_ACK_TIMEOUT_MS=5000
VEYRA_GATEWAY_MAX_BODY_BYTES=10485760
VEYRA_NORM_BATCH_MAX=500
VEYRA_NORM_BATCH_MS=100
VEYRA_POISON_MAX_RETRIES=3
VEYRA_SINK_ROTATE_BYTES=67108864
VEYRA_ROUTE_QUEUE_MAX=10000
VEYRA_ROUTE_BREAKER_FAILS=5
VEYRA_ROUTE_FSYNC_MS=200
VEYRA_WAZUH_MODE=local
# Wazuh credentials are the image defaults until S2 rotates them with wazuh-passwords-tool;
# `make wazuh-init` uploads the image's own security config, which carries these hashes.
VEYRA_WAZUH_INDEXER_PASSWORD=admin
VEYRA_WAZUH_DASHBOARD_PASSWORD=kibanaserver
VEYRA_WAZUH_API_PASSWORD=MyS3cr37P450r.*-
VEYRA_WAZUH_REMOTE_HOST=
VEYRA_WAZUH_REMOTE_PORT=514

# --- §2.4 demo, LLM, drift ---------------------------------------------------
VEYRA_DEMO_EPS_BASELINE=15
VEYRA_BENCH_TARGET_EPS=2000
VEYRA_LLM_MODEL=qwen2.5:3b
VEYRA_LLM_NUM_CTX=4096
VEYRA_LLM_TIMEOUT_S=25
VEYRA_LLM_MODE=live_then_cache
VEYRA_OLLAMA_URL=http://host.docker.internal:11434
VEYRA_DRIFT_MIN_CLUSTER=5
VEYRA_SSE_TICK_MS=1000
VEYRA_DEMO_MODE=0
